# LecturAI Environment Configuration
# Copy this file to .env and insert your API keys

# Groq API Configuration (Free tier available at https://console.groq.com)
GROQ_API_KEY=

# Configurable Groq Models (Current non-deprecated models)
GROQ_MODEL_PRIMARY=llama-3.3-70b-versatile
GROQ_MODEL_FALLBACK=llama-3.1-8b-instant

# Optional secondary fallback models (comma-separated)
GROQ_MODELS_EXTRA=llama-3.1-70b-versatile,gemma2-9b-it

# Optional local/alternative LLM provider ('groq', 'ollama', 'openai')
LLM_PROVIDER=groq
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# Server Port
PORT=5000
